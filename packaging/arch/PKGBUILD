pkgname=source-canvas-git
pkgver=r100.g6c8031d
pkgrel=1
pkgdesc='Spatial source browser with language servers and agent conversations'
arch=('x86_64')
url='https://github.com/jexxor/code-exp-02'
license=('custom')
depends=('libx11' 'pango' 'fontconfig' 'glib2' 'gdk-pixbuf2' 'libepoxy' 'python' 'python-websockets')
makedepends=('git' 'cmake' 'pkgconf' 'clang' 'nlohmann-json')
optdepends=('gopls: Go language features' 'zenity: project directory picker')
source=("source-canvas::git+file://${HOME}/Zone/Topics/source-canvas#branch=dev")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/source-canvas"
    printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cmake -UCLANGD_EXECUTABLE -UGOPLS_EXECUTABLE \
        -S "${srcdir}/source-canvas" -B "${srcdir}/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DFORMAT_ON_CONFIGURE=OFF \
        -DENABLE_CLANG_TIDY=OFF \
        -DBUILD_TESTING=OFF \
        -DPython3_EXECUTABLE=/usr/bin/python3 \
        -DSOURCE_CANVAS_DEFAULT_PROJECT_ROOT="${HOME}/Zone/Topics/source-canvas" \
        -DSOURCE_CANVAS_DEFAULT_BUILD_ROOT="${HOME}/Zone/Topics/source-canvas/build"
    cmake --build "${srcdir}/build" --target white_window
}

package() {
    local appdir="${pkgdir}/usr/lib/source-canvas"
    install -Dm755 "${srcdir}/build/white_window" "${appdir}/white_window"
    install -Dm644 "${srcdir}/build/agent_bridge.py" "${appdir}/agent_bridge.py"
    install -Dm644 "${srcdir}/build/intents.py" "${appdir}/intents.py"
    cp -a "${srcdir}/build/fonts" "${appdir}/fonts"

    install -d "${pkgdir}/usr/bin" "${pkgdir}/usr/share/applications"
    ln -s ../lib/source-canvas/white_window "${pkgdir}/usr/bin/source-canvas"
    cat > "${pkgdir}/usr/share/applications/source-canvas.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Source Canvas
Exec=source-canvas
TryExec=source-canvas
Icon=accessories-text-editor
Terminal=false
Categories=Development;
EOF

    install -Dm644 "${srcdir}/source-canvas/fonts/victor-mono/OFL.txt" \
        "${pkgdir}/usr/share/licenses/${pkgname}/Victor-Mono-OFL.txt"
    install -Dm644 "${srcdir}/source-canvas/fonts/noto-serif/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/Noto-Serif-LICENSE"
}
